{
  "name": "double-decker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A two-deck programming system: a code-free map on top, real code underneath.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "fixtures": "node fixtures/build.ts",
    "build": "npm run fixtures && npm run build -w @decker/web",
    "dev": "npm run dev -w @decker/web",
    "decker": "node packages/server/bin/decker.mjs",
    "demo": "node packages/server/bin/decker.mjs examples/shop",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/web/tsconfig.json && tsc -p e2e/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
